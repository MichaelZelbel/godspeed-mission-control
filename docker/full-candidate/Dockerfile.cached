ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY . /opt/godspeed/kit/
RUN test "$(node --version)" = "v22.19.0" && chmod 755 /opt/godspeed/kit/docker/full-candidate/entrypoint.sh && chown -R hermes:hermes /opt/godspeed/kit
ARG REVISION
ARG BASE_IMAGE
LABEL org.opencontainers.image.title="Godspeed Mission Control Full Alpha" org.opencontainers.image.revision="${REVISION}" org.opencontainers.image.version="2.0.0-alpha.1" godspeed.cached-base="${BASE_IMAGE}"
ENTRYPOINT ["/opt/godspeed/kit/docker/full-candidate/entrypoint.sh"]
CMD []
