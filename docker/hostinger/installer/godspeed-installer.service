[Unit]
Description=Godspeed Mission Control installation coordinator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/godspeed-hostinger-installer
ExecStart=/usr/bin/node /opt/godspeed-hostinger-installer/server.mjs
Environment=GODSPEED_INSTALL_STATE=/var/lib/godspeed-installer
# The live coordinator is the website's (godspeedmissioncontrol.com, since 2026-10-15). A coordinator
# you run yourself from this folder sets its own public address here.
Environment=GODSPEED_INSTALL_ORIGIN=https://godspeedmissioncontrol.com/godspeed-install
Environment=GODSPEED_INSTALL_BIND=10.0.0.1
Environment=GODSPEED_INSTALL_PROXY=host.docker.internal:8794
StateDirectory=godspeed-installer
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=96M
TasksMax=32

[Install]
WantedBy=multi-user.target
