# Planino waker configuration. Save in the selected workspace device-private connector folder.
# Every line here also reaches the runner script as an environment variable.

# The poster token from Planino (Settings, AI poster). Required.
PLANINO_POSTER_TOKEN=pln_poster_...

# Configure the actual poster API. No account endpoint is bundled.
# Save this file in GODSPEED_WORKSPACE/.godspeed/connectors/browser-post/poster.env.
# Device credentials must never be saved inside synced skills.
# GODSPEED_ASSISTANT_HOME is the chosen isolated assistant home.
# PLANINO_POSTER_URL=https://your-configured-poster-api.example/browser-poster

# The Chrome Agent Bridge profile your AI posts through. Its /health is
# reported to Planino at every check-in.
BRIDGE_URL=http://127.0.0.1:3007
# BRIDGE_TOKEN=            # only if the bridge was started with one

# What to run when a job is queued. It gets the job id as its argument and
# JOB_ID, JOB_PLATFORM, PLANINO_POSTER_URL, PLANINO_POSTER_TOKEN and
# BRIDGE_URL in its environment.
#   runners/claude.sh   Claude Code, headless, with this kit's posting rules (poster/skill/SKILL.md)
#   runners/hermes.sh   a Hermes profile with the same rules
RUNNER=./runners/claude.sh

# Knobs for the runners.
# GODSPEED_WORKSPACE=/path/to/selected-workspace
# CLAUDE_BIN=claude              # claude.sh: the executable
# HERMES_PROFILE=your-isolated-profile         # hermes.sh: which profile

# Substack: your publication's subdomain, yourname for yourname.substack.com.
# SUBSTACK_PUBLICATION=yourname
# HERMES_BIN=hermes              # hermes.sh: the executable

# Timing. Peek every POLL_SEC seconds; check in every CHECKIN_SEC; kill a run
# that lasts longer than RUN_TIMEOUT_SEC.
POLL_SEC=120
CHECKIN_SEC=300
RUN_TIMEOUT_SEC=600

# The name reported to Planino for this poster's harness. Default: the runner's name.
# HARNESS=claude-code
