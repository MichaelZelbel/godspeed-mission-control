{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/moonshotai/kimi-k3",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask"
  },
  "mcp": {
    "notebook": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:47831/mcp"
    },
    "mc-mail": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "-e",
        "require(require('path').join(require('os').homedir(),'.local','bin','mc-mail.js')).main(process.argv.slice(1))",
        "mcp"
      ]
    }
  }
}
