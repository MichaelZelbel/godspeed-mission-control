[
  { "name": "start without definition gets exactly one question",
    "setup": [], "message": "Journal: starting on the Ko-fi page",
    "expect_files": { "start": 1 }, "reply_matches": "(?i)what does done look like", "reply_max_lines": 1 },
  { "name": "start with definition gets Saved only",
    "setup": [], "message": "journal, starting the invoice for September, done means sent and filed in the tax folder",
    "expect_files": { "start": 1 }, "reply_matches": "(?i)^saved", "reply_max_lines": 2 },
  { "name": "finish with a missing item asks about exactly that item",
    "setup": [["start", "Edit video", "--done-means", "thumbnail made", "--done-means", "description written"]],
    "message": "journal: video is done, thumbnail looks great",
    "expect_files": { "done": 1 }, "reply_matches": "(?i)description", "reply_not_matches": "(?i)great job|well done|thumbnail.*missing" },
  { "name": "finish with everything met confirms briefly",
    "setup": [["start", "Edit video", "--done-means", "thumbnail made"]],
    "message": "journal: video done, thumbnail made", "expect_files": { "done": 1 }, "reply_max_lines": 2 },
  { "name": "feedback off replies Saved and never asks",
    "config": [["feedback", "off"]], "setup": [], "message": "journal: starting taxes",
    "expect_files": { "start": 1 }, "reply_matches": "(?i)^saved\\.?$" },
  { "name": "config change in plain words",
    "setup": [], "message": "stop the journal check-ins please",
    "expect_setting": ["nudge.enabled", false], "reply_max_lines": 1 },
  { "name": "unrelated message with an open task answers the message and says nothing about the task",
    "setup": [["start", "Edit video", "--done-means", "thumbnail made"]], "now_offset_min": 45,
    "message": "what's the capital of Portugal?",
    "reply_matches": "(?i)lisbon|lissabon", "reply_not_matches": "(?i)edit video|paused|journal", "expect_files": { "mark": 0 } },
  { "name": "German voice transcript with misheard brand still matches",
    "setup": [["start", "Blogartikel", "--done-means", "Link zum Ko-fi Shop", "--done-means", "auf Substack geplant"]],
    "message": "Tagebuch: Blogartikel fertig, Link zum Kofi-Shop gesetzt und auf Substatt geplant",
    "expect_files": { "done": 1 }, "reply_not_matches": "(?i)not in what you|fehlt" },
  { "name": "a loose end that happened after all is settled with met",
    "setup": [["start", "Chimney cleaner letter", "--done-means", "letter signed", "--done-means", "letter scanned"],
              ["done", "chimney", "--met", "letter scanned", "--missed", "letter signed"]],
    "message": "journal: the chimney letter is signed now",
    "expect_files": { "met": 1, "done": 0, "note": 0 }, "reply_matches": "(?i)^saved", "reply_max_lines": 1 },
  { "name": "a loose end is never brought up unasked",
    "setup": [["start", "Chimney cleaner letter", "--done-means", "letter signed"],
              ["done", "chimney", "--missed", "letter signed"]],
    "message": "what's the capital of Portugal?",
    "expect_files": { "met": 0, "note": 0 }, "reply_not_matches": "(?i)letter|chimney|signed" }
]
