#!/usr/bin/env bash
# hub-decide: your hub's one decision of the day.
#
# WHAT IT DOES. Before anything is written to you in the morning, your hub decides against your
# GOALS rather than against whatever queue is shouting loudest. It moves time on the work
# tracker, works out which goals get attention today and why, lists the forecasts that have come
# due, and then runs the `next-action` recipe with all of that in front of it. The recipe writes
# one record for the day, files the work your hub will do itself, and puts at most one thing in
# front of you.
#
# IT KNOWS NO GOAL AND NO ACTION, AND THAT IS THE DESIGN. Adding a goal means adding a file under
# `goals/`. It never means another line in here and never another entry in your schedule. Same
# rule as `due/`: one program, many small files.
#
# IT NEVER MESSAGES YOU AND IT NEVER POSTS. Anything that goes outside your machine is filed as
# blocked until your own words are on it.
#
# WHAT IT NEEDS: node, one assistant (hermes, claude or codex), and a `next-action` recipe in
# your hub. Everything else it uses is optional and it says so when a piece is missing.
#
# RUN IT BY HAND:        hub-decide
# SEE THE PLAN ONLY:     hub-decide --dry-run
# ONCE A DAY, ON LINUX or a Mac, in your schedule (`crontab -e`), early enough that the morning
# message can read what it decided:
#        10 4 * * *  $HOME/.local/bin/hub-decide >> $HOME/.hub/decide.log 2>&1
set -uo pipefail

HUB=""; DRY=0; TODAY=""; RUNDIR=""; TIMEOUT=1500; EXTRA=""
while [ $# -gt 0 ]; do
  case "$1" in
    --hub) HUB="$2"; shift 2 ;;
    --date) TODAY="$2"; shift 2 ;;
    --run-dir) RUNDIR="$2"; shift 2 ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    # A hub that has grown things this kit knows nothing about puts them in a file and names it
    # here, and they are added to the recipe for this run only. That is what keeps the recipe
    # itself general: an addition never has to be merged into it and then kept out of everybody
    # else's copy.
    --extra-prompt-file) EXTRA="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "hub-decide: I do not know the argument $1" >&2; exit 2 ;;
  esac
done

looks_like_hub() { [ -d "${1:-}/rules" ] || [ -d "${1:-}/observations" ]; }
if [ -z "$HUB" ]; then HUB="${HUB_ROOT:-}"; fi
if [ -z "$HUB" ] || ! looks_like_hub "$HUB"; then
  D="$PWD"; HUB=""
  for _ in 1 2 3 4 5 6 7 8; do
    looks_like_hub "$D" && { HUB="$D"; break; }
    P="$(dirname "$D")"; [ "$P" = "$D" ] && break; D="$P"
  done
fi
if [ -z "$HUB" ] && [ -r "$HOME/.hub/device.env" ]; then
  HUB="$(sed -n 's/^[[:space:]]*\(export[[:space:]]*\)\{0,1\}HUB_DIR=//p' "$HOME/.hub/device.env" | tail -1 | tr -d '"'"'"' ' | tr -d '\r')"
fi
if [ -z "$HUB" ] || ! looks_like_hub "$HUB"; then
  echo "hub-decide: I could not find your hub. Run this inside it, or pass --hub /path/to/hub." >&2
  exit 2
fi
cd "$HUB" || exit 2
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
[ -n "$TODAY" ] || TODAY="${HUB_TODAY:-$(date -u +%Y-%m-%d)}"
[ -n "$RUNDIR" ] || RUNDIR="$HUB/routines/next-action/$TODAY"
HERE="$(cd "$(dirname "$0")" && pwd)"

# FIND NODE BY RUNNING IT, NEVER BY FINDING IT. A schedule starts a job with almost none of your
# environment, and on Windows there is a stub on the path called python3 that exists and only
# prints an advert. The same trap is waiting for every runtime.
NODE=""
for c in node nodejs /usr/local/bin/node /usr/bin/node; do
  "$c" -e '' >/dev/null 2>&1 && { NODE="$c"; break; }
done
[ -n "$NODE" ] || { echo "hub-decide: there is no Node.js on this computer, so nothing could be run." >&2; exit 1; }

# A PROGRAM THAT IS NOT INSTALLED IS NOT AN ERROR HERE. Two of the three registers are useful on
# their own, and a reader may have installed only some of this. Each one that is missing is
# named once, in the record, and the day still gets decided.
MISSING=""
reg() {
  local name="$1"; shift
  local bin="$HERE/$name.js"
  [ -f "$bin" ] || bin="$HOME/.local/bin/$name.js"
  if [ ! -f "$bin" ]; then
    case " $MISSING " in *" hub-$name "*) : ;; *) MISSING="$MISSING hub-$name" ;; esac
    return 1
  fi
  HUB_ROOT="$HUB" "$NODE" "$bin" "$@"
}

mkdir -p "$RUNDIR"
# The part that needs no model runs first and is kept even if the model run dies: time passes on
# the work tracker whether or not anything else works today.
reg work tick            > "$RUNDIR/tick.txt"           2>/dev/null || true
reg goals attention --date "$TODAY" > "$RUNDIR/attention.txt" 2>/dev/null || true
reg forecast due --date "$TODAY"    > "$RUNDIR/forecasts-due.txt" 2>/dev/null || true

# Optional neighbours. A hub that has one of them gets its output in the same folder, and a hub
# that does not gets a note saying so and nothing else.
#
# TELL EACH ONE WHICH HUB IT IS READING. Found by running this in a second hub on a machine that
# already had one: these programs each work out the folder for themselves, and one of them
# answered from the machine's usual hub instead of the one being decided. The run then reported
# three deadlines that were not in this folder at all. A program that guesses the folder is fine
# on a machine with one hub and quietly wrong on a machine with two.
#
# They are named one at a time rather than in a list, because they do not all take the folder the
# same way: one reads the environment, the other takes it as an option. A loop that pretended
# otherwise is exactly how the wrong folder got read in the first place.
neighbour() { case " $MISSING " in *" $1 "*) : ;; *) MISSING="$MISSING $1" ;; esac; }
if command -v hub-due >/dev/null 2>&1; then
  HUB_ROOT="$HUB" hub-due --hub "$HUB" today > "$RUNDIR/due.txt" 2>/dev/null || true
else neighbour hub-due; fi
if command -v hub-attention >/dev/null 2>&1; then
  HUB_ROOT="$HUB" hub-attention outcomes --days 14 > "$RUNDIR/outcomes.txt" 2>/dev/null || true
else neighbour hub-attention; fi
[ -n "$MISSING" ] && printf 'not on this computer, so today was decided without it:%s\n' "$MISSING" > "$RUNDIR/missing.txt"

if [ "$DRY" -eq 1 ]; then
  echo "Attention plan for $TODAY:"; cat "$RUNDIR/attention.txt" 2>/dev/null
  echo; echo "Work tracker:"; cat "$RUNDIR/tick.txt" 2>/dev/null
  [ -n "$MISSING" ] && { echo; cat "$RUNDIR/missing.txt"; }
  echo; echo "Nothing was decided and nothing was written: this was a dry run."
  exit 0
fi

# A DECISION ALREADY WRITTEN TODAY IS NOT WRITTEN TWICE. A schedule that fires twice, or a run
# you start by hand after one that failed, must not produce two plans for one day. The runner's
# own "it did not run" record does not count as a decision, so a retry after a failure decides.
if [ -s "$RUNDIR/decision.md" ] && ! grep -q "did not finish and wrote no record of its own" "$RUNDIR/decision.md"; then
  echo "$TODAY is already decided ($RUNDIR/decision.md). Nothing was decided twice."
  exit 0
fi

RUNNER="$HERE/hub-run"
[ -x "$RUNNER" ] || RUNNER="$HOME/.local/bin/hub-run"
[ -x "$RUNNER" ] || { echo "hub-decide: hub-run is not installed, so no recipe could be carried out." >&2; exit 3; }

PROMPT="Today is $TODAY (UTC). The run folder is $RUNDIR and it already holds attention.txt (the
goal plan), tick.txt (the work tracker) and forecasts-due.txt from this morning, plus anything
else that was available. Follow the next-action recipe exactly. Write $RUNDIR/decision.md, file
the work and at most one thing for the person whose hub this is, carry out the work you took if
it fits in the time, and save what you changed. Your final answer is the 'For you today' section
in one plain sentence, plus the card id or the word nothing."

if [ -n "$EXTRA" ] && [ -f "$EXTRA" ]; then
  bash "$RUNNER" next-action --hub "$HUB" --cwd "$HUB" --prompt-file "$EXTRA" --prompt "$PROMPT" \
    --timeout "$TIMEOUT" --out "$RUNDIR/answer.txt" \
    --allowed-tools "Bash Read Grep Glob Write Edit WebSearch WebFetch" || true
else
  bash "$RUNNER" next-action --hub "$HUB" --cwd "$HUB" --prompt "$PROMPT" --timeout "$TIMEOUT" \
    --out "$RUNDIR/answer.txt" \
    --allowed-tools "Bash Read Grep Glob Write Edit WebSearch WebFetch" || true
fi

# EVERY RUN LEAVES A RECORD DATED TODAY. If the assistant wrote none, this writes the honest
# version, so a missing file means "it did not run" and can never be mistaken for "there was
# nothing to decide".
if [ ! -s "$RUNDIR/decision.md" ]; then
  {
    echo "# Decision $TODAY"
    echo
    echo "## Not done and why"
    echo "The decision run did not finish and wrote no record of its own. This file was written by"
    echo "hub-decide so that the gap is not mistaken for a day with nothing to decide. The goal plan"
    echo "it was given is in attention.txt next to this file."
  } > "$RUNDIR/decision.md"
fi

# Loud on purpose: a register check that fails quietly is worse than no check at all.
reg goals check    || true
reg work check     || true
reg forecast check || true

# Save it, if this hub is a git repository and you keep one. A hub that is just a folder is fine
# and this does nothing at all.
if [ -d "$HUB/.git" ] && command -v git >/dev/null 2>&1; then
  for d in goals forecasts work attention routines; do [ -d "$HUB/$d" ] && git -C "$HUB" add "$d" >/dev/null 2>&1; done
  if ! git -C "$HUB" diff --cached --quiet 2>/dev/null; then
    git -C "$HUB" commit -q -m "Decision $TODAY" >/dev/null 2>&1 || true
    git -C "$HUB" remote get-url origin >/dev/null 2>&1 && git -C "$HUB" push -q origin HEAD >/dev/null 2>&1 || true
  fi
fi
echo "decided $TODAY: $RUNDIR/decision.md"
