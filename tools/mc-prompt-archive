#!/usr/bin/env python3
"""mc-prompt-archive - put what you actually typed into your mission control, so any AI can search it.

WHY THIS FILE EXISTS. You should be able to ask any of your assistants about a prompt you
wrote months ago, or a project you did with one. The raw material already exists and nothing
can reach it: every AI tool keeps its own conversation logs, on one machine, outside your
folder, in its own format, and deletes them when it feels like it. On the machine this was
first written for, Claude Code alone held 121 conversation files.

THE NUMBER THAT DECIDED THE DESIGN. Those 121 files are 398 MB, which sounds like something
that cannot live in a git repo. Measured properly, only 565 of the 25,488 "user" entries are
things a human typed; the other 24,590 are tool results the harness files under the same
label. The real text is 1.4 MB. So it goes in the repo, plainly, exactly as he said it
should, and every machine gets it through the sync that already exists. Harvest the human
turns and what the AI showed back for them, never the raw transcript.

THE ANSWER RIDES WITH THE PROMPT. Since 2026-08-11 each archived row also carries the AI's
reply, in an "answer" field, because half the time what a person half-remembers is not what
they typed but what came back. Only text the person actually SAW is kept: internal thinking,
tool calls and tool output are machinery, never answer. An answer longer than the cap is cut
after scrubbing, with a marker saying so. Rows written before this existed simply lack the
field; `backfill` fills it in from transcripts that still exist.

WHAT IS REMOVED BEFORE ANYTHING IS WRITTEN. A session transcript is the one place secrets
show up by accident: a key pasted while debugging, an employer or client name that this mission control
is not allowed to hold. So every line passes a scrubber first:

  - by shape, needing no configuration: API keys and tokens, Authorization headers,
    private-key blocks, long random-looking strings, email addresses;
  - by name, from a list you keep OUTSIDE your mission control, because a list of the names you must
    never store is itself a file you must never store. Put one name per line in
    ~/.godspeed/redact.txt, or set GODSPEED_REDACT_TERMS.

A PROMPT that still looks risky after scrubbing is dropped whole rather than half-cleaned:
refusing to store a prompt costs one prompt; storing a key costs a key. An ANSWER loses only
the offending line, because replies legitimately carry commit hashes and encoded data, and
dropping a whole reply for one such line would empty the drawer of exactly what it is for.

Usage:
  mc-prompt-archive                       harvest this machine, write into prompts/archive/
  mc-prompt-archive --dry-run             show what it would add, write nothing
  mc-prompt-archive search <term>...      search everything every machine has archived
  mc-prompt-archive stats                 what is in the archive, and which machine stopped sending
  mc-prompt-archive sources               every place on THIS machine he types, and whether the
                                           archive has it. Exit 1 if a source reaches none of it.
  mc-prompt-archive rescrub               re-run the scrubber over what is already stored,
                                           for the day a name is added to the list too late
  mc-prompt-archive backfill              attach answers to rows archived before answers
                                           existed, from transcripts still on this machine
Options:
  --godspeed DIR · --since YYYY-MM-DD · --limit N (search results, default 12)
"""

import glob
import hashlib
import io
import json
import os
import re
import socket
import sys
from datetime import datetime, timezone

try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass


def home_dir():
    """Where the AI tools keep their session logs.

    GODSPEED_HOME wins, and it exists for two real reasons rather than for tidiness. On Windows,
    Python resolves "~" from USERPROFILE and ignores HOME, so a test that sets HOME silently
    harvests your real sessions instead of its fixture, and reports green. And on the
    server this runs from cron, where HOME is whatever systemd decided.
    """
    return os.environ.get("GODSPEED_HOME") or os.path.expanduser("~")


# The sources this collector can read. The installer shows this same list to the
# person as checkboxes; a new reader here must also be added to the installer's
# roster (kit-bootstrap: kb_ai_tool_info / Get-KitAiToolInfo), or nobody can
# switch it off.
SUPPORTED_SOURCES = ("claude", "codex", "hermes")


def device_env_value(name):
    """One value from ~/.godspeed/device.env. Read here as well as by the launcher,
    because this program is also run directly (`godspeed prompts archive`), where
    nothing has loaded that file into the environment first."""
    p = os.path.join(home_dir(), ".godspeed", "device.env")
    if not os.path.isfile(p):
        return None
    try:
        for raw in io.open(p, encoding="utf-8", errors="replace"):
            line = re.sub(r"^\s*export\s+", "", raw)
            if line.lstrip().startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == name:
                return v.strip().strip('"').strip("'")
    except (IOError, OSError):
        pass
    return None


def enabled_sources():
    """Which AI tools this machine's owner said may be read.

    The installer records the choice as GODSPEED_PROMPT_SOURCES in ~/.godspeed/device.env
    (the environment wins, so a test or a one-off run can override it). No line
    at all means every supported source, which is what every machine did before
    there was a choice. An EMPTY line means none: a person who unticked every
    box made a decision, not a mistake.
    """
    v = os.environ.get("GODSPEED_PROMPT_SOURCES")
    if v is None:
        v = device_env_value("GODSPEED_PROMPT_SOURCES")
    if v is None:
        return set(SUPPORTED_SOURCES)
    if v.strip() == "-":
        # "-" is NONE spelled so it survives a Windows environment variable,
        # which cannot hold an empty string.
        return set()
    return {s.strip().lower() for s in v.split(",") if s.strip()}


def godspeed_root(argv_godspeed=None):
    if argv_godspeed:
        return os.path.abspath(argv_godspeed)
    env = os.environ.get("GODSPEED_DIR")
    if env:
        return os.path.abspath(env)
    here = os.path.dirname(os.path.abspath(__file__))
    cand = os.path.abspath(os.path.join(here, "..", ".."))
    if looks_like_godspeed(cand):
        return cand
    for c in ("/root/godspeed", os.path.expanduser("~/godspeed"), "C:\\godspeed"):
        if looks_like_godspeed(c):
            return c
    return cand


# A mission control is recognised by the folders it declares, not by one hardcoded name. This asked for
# `memory/` until 2026-08-29, which stopped being a mission control folder on 2026-08-21, and the starter
# godspeed this kit installs has never had one. See the long note in prompt-harvest.js: the two
# programs are a pair and they have to agree about what a mission control is.
GODSPEED_MARKERS = ("observations", "profile", "rules", "prompts", "memory")


def looks_like_godspeed(path):
    if not path:
        return False
    if os.path.isfile(os.path.join(path, "scripts", "config", "mc-layout.json")):
        return True
    return any(os.path.isdir(os.path.join(path, d)) for d in GODSPEED_MARKERS)


# --------------------------------------------------------------- the scrubber

SECRET_PATTERNS = [
    (re.compile(r"\b(sk|pk|rk)-[A-Za-z0-9_\-]{16,}", re.I),        "[key removed]"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{16,}"),                   "[key removed]"),
    (re.compile(r"\bxox[baprs]-[A-Za-z0-9\-]{10,}"),                "[key removed]"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"),                           "[key removed]"),
    (re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}"),                      "[key removed]"),
    (re.compile(r"\bey[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"), "[token removed]"),
    # To END OF LINE, not to the next space. \S+ ate only the word "Bearer" and left the
    # token sitting there in plain sight, which the test caught on the first run. A header
    # value has spaces in it, so a pattern that stops at one is a pattern that leaks.
    (re.compile(r"(?i)\bauthorization\s*:.*"),                       "authorization: [removed]"),
    (re.compile(r"(?i)\b(bearer)\s+\S{8,}"),                         r"\1 [removed]"),
    (re.compile(r"(?i)\b(api[_-]?key|secret|token|password|passwd|pwd)\s*[:=]\s*\S+"),
     r"\1=[removed]"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", re.S),
     "[private key removed]"),
    (re.compile(r"\bage1[a-z0-9]{40,}"),                            "[key removed]"),
    (re.compile(r"\b[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}\b"), "[email removed]"),
]

# Something that still looks like a credential after the passes above. Anything matching
# this is not cleaned, it is dropped: a half-scrubbed secret is a stored secret.
STILL_RISKY = re.compile(r"[A-Za-z0-9+/_\-]{40,}={0,2}")


def redact_terms():
    out = []
    env = os.environ.get("GODSPEED_REDACT_TERMS", "")
    out += [t.strip() for t in env.split(",") if t.strip()]
    p = os.path.join(home_dir(), ".godspeed", "redact.txt")
    if os.path.isfile(p):
        for line in io.open(p, encoding="utf-8", errors="replace"):
            line = line.split("#", 1)[0].strip()
            if line:
                out.append(line)
    return [t for t in out if len(t) >= 3]


def _looks_credential(text):
    """A long run of mixed case and digits is a credential; a long path or a long word
    is not. Requiring all three classes is what stops it eating ordinary prose."""
    for m in STILL_RISKY.finditer(text):
        chunk = m.group(0)
        if (any(c.isdigit() for c in chunk) and any(c.islower() for c in chunk)
                and any(c.isupper() for c in chunk)):
            return True
    return False


def scrub(text, terms):
    """Returns (clean_text, dropped_reason_or_None)."""
    t = text
    for rx, rep in SECRET_PATTERNS:
        t = rx.sub(rep, t)
    for term in terms:
        t = re.sub(re.escape(term), "[name removed]", t, flags=re.I)
    if _looks_credential(t):
        return None, "contains something that still looks like a credential"
    return t, None


# --------------------------------------------------------------- the answers

# What the AI showed back, kept beside what the person typed. "all" keeps every piece
# of text the AI displayed during a turn, because findings often appear between work
# steps, not only in the closing message; "final" would keep only the last one.
# Internal thinking and tool machinery are never kept under either scope.
ANSWER_SCOPE = "all"

# A reply is worth keeping whole; a reply that pasted a whole file is not. The cap is
# applied AFTER scrubbing, so the scrubber always sees the full text and no secret can
# sit astride the cut.
ANSWER_CAP = 20000


def join_answer(msgs):
    if not msgs:
        return ""
    if ANSWER_SCOPE == "final":
        return msgs[-1]
    return "\n\n".join(msgs)


def scrub_answer(text, terms):
    """Same redaction as scrub(), except that a line still looking like a credential is
    removed ALONE, never the whole answer. A prompt is short, so dropping it whole costs
    one prompt; an answer legitimately carries commit hashes and encoded data, and the
    whole-drop rule would gut the drawer of exactly the replies worth finding again."""
    t = text
    for rx, rep in SECRET_PATTERNS:
        t = rx.sub(rep, t)
    for term in terms:
        t = re.sub(re.escape(term), "[name removed]", t, flags=re.I)
    kept = []
    for line in t.split("\n"):
        kept.append("[line removed: still looked like a credential]"
                    if _looks_credential(line) else line)
    return "\n".join(kept).strip()


def prepare_answer(raw, terms):
    """Scrub, then cap. Returns "" when nothing worth storing is left."""
    t = scrub_answer(raw, terms)
    if len(t) > ANSWER_CAP:
        t = (t[:ANSWER_CAP]
             + "\n[answer truncated by mc-prompt-archive: kept %d of %d characters]"
             % (ANSWER_CAP, len(t)))
    return t


# ------------------------------------------------------------------ harvesting

def human_turns_claude(paths):
    """Human turns, each carrying the texts the AI showed back during that turn.

    The transcript writes every content block as its own line: a "user" line is either
    the human typing or a tool result filed under the same label, and an "assistant"
    line carries one block - internal thinking, a tool call, or a piece of text the
    person actually saw. Only the text blocks become the answer. Each assistant line
    names its parent entry, and following that chain upward ends at the human turn it
    belongs to; when a hop leaves the file (a resumed or compacted session), the
    nearest preceding turn in file order is the same answer measured the cheap way,
    verified equivalent on real transcripts. A turn we skip as a prompt (a meta block,
    an interrupted request) still owns its replies: they are discarded with it, never
    glued onto the previous real turn.
    """
    for f in paths:
        proj = os.path.basename(os.path.dirname(f))
        entries, byid = [], {}
        try:
            src = io.open(f, encoding="utf-8", errors="replace")
        except (IOError, OSError):
            continue
        with src:
            for line in src:
                is_user = '"type":"user"' in line or '"type": "user"' in line
                is_asst = '"type":"assistant"' in line or '"type": "assistant"' in line
                if not is_user and not is_asst:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                typ = d.get("type")
                if typ not in ("user", "assistant"):
                    continue
                e = {"uuid": d.get("uuid"), "parent": d.get("parentUuid"),
                     "kind": None, "turn": None, "texts": None, "prev_turn": None}
                c = d.get("message", {}).get("content")
                if typ == "user":
                    if isinstance(c, str):
                        txt = c
                    elif isinstance(c, list):
                        # A tool result is filed as a "user" entry too. That is the 24,590.
                        if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
                            e["kind"] = "tool"
                            entries.append(e)
                            if e["uuid"]:
                                byid[e["uuid"]] = e
                            continue
                        txt = " ".join(b.get("text", "") for b in c
                                       if isinstance(b, dict) and b.get("type") == "text")
                    else:
                        continue
                    txt = (txt or "").strip()
                    if not txt or txt.startswith("<") or txt.startswith("[Request interrupted"):
                        e["kind"] = "skipped-turn"
                    else:
                        e["kind"] = "turn"
                        e["turn"] = {"tool": "claude-code", "project": proj,
                                     "at": d.get("timestamp", ""), "text": txt,
                                     "answers": []}
                else:
                    texts = []
                    if isinstance(c, list):
                        texts = [(b.get("text") or "").strip() for b in c
                                 if isinstance(b, dict) and b.get("type") == "text"]
                        texts = [t for t in texts if t]
                    e["kind"] = "assistant-text" if texts else "assistant-quiet"
                    e["texts"] = texts
                entries.append(e)
                if e["uuid"]:
                    byid[e["uuid"]] = e

        # File order gives the fallback: the nearest turn before this entry.
        prev = None
        for e in entries:
            e["prev_turn"] = prev
            if e["kind"] in ("turn", "skipped-turn"):
                prev = e
        for e in entries:
            if e["kind"] != "assistant-text":
                continue
            cur, hops = byid.get(e["parent"]), 0
            while cur is not None and cur["kind"] not in ("turn", "skipped-turn") and hops < 500:
                cur = byid.get(cur["parent"])
                hops += 1
            if cur is None or cur["kind"] not in ("turn", "skipped-turn"):
                cur = e["prev_turn"]
            if cur is not None and cur["kind"] == "turn":
                cur["turn"]["answers"].extend(e["texts"])
        for e in entries:
            if e["kind"] == "turn":
                yield e["turn"]


def human_turns_codex(paths):
    """One turn per user message, in file order, carrying the assistant texts that
    followed it. Two shapes to know: the same user message can arrive twice (once as
    the response record, once as an event copy), which must stay one turn, not two;
    and the assistant's tool traffic arrives as messages whose text opens with
    "[external_agent_tool_call" / "[external_agent_tool_result" - machinery, never
    answer, and without this filter every agentic turn would embed its whole tool
    transcript."""
    for f in paths:
        cur = None
        try:
            src = io.open(f, encoding="utf-8", errors="replace")
        except (IOError, OSError):
            continue
        with src:
            for line in src:
                if '"user"' not in line and '"assistant"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                pay = d.get("payload", d)
                role = pay.get("role")
                if role == "user" or pay.get("type") in ("user_message",):
                    c = pay.get("content", pay.get("message", ""))
                    if isinstance(c, list):
                        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
                    c = (c or "").strip() if isinstance(c, str) else ""
                    if not c or c.startswith("<"):
                        # Not a prompt, but still where a turn ends.
                        if cur:
                            yield cur
                        cur = None
                        continue
                    if cur and cur["text"] == c:
                        continue
                    if cur:
                        yield cur
                    cur = {"tool": "codex", "project": "", "at": d.get("timestamp", ""),
                           "text": c, "answers": []}
                elif role == "assistant" and cur is not None:
                    if pay.get("type") not in ("message",):
                        continue
                    c = pay.get("content", "")
                    if isinstance(c, list):
                        c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
                    c = (c or "").strip() if isinstance(c, str) else ""
                    if (not c or c.startswith("[external_agent_tool_call")
                            or c.startswith("[external_agent_tool_result")):
                        continue
                    cur["answers"].append(c)
        if cur:
            yield cur


def human_turns_hermes(path):
    """Your side of a chat log written as one line per message.

    TWO SHAPES, AND THE SECOND ONE IS THE REAL FILE. This started out reading a "role" or
    "from" field, which is what a chat log usually has. A real one turned out to have
    neither: every line was {"ts": ..., "dir": "in"|"out", "text": ...}, where "in" means the
    person typed it and "out" means the bot said it. So the filter matched nothing at all, on
    every line, for as long as it existed. Nothing failed and nothing was logged; the drawer
    was simply empty of everything typed from a phone. Both shapes are read now, and the test
    suite holds the "dir" one shut.

    The bot's side ("out", or an assistant role) is never a prompt of its own - a drawer of
    our own words would make every search return the answer instead of the question - but it
    IS the answer of the turn above it, so it rides along in that turn's "answers".
    """
    if not os.path.isfile(path):
        return
    cur = None
    try:
        for line in io.open(path, encoding="utf-8", errors="replace"):
            try:
                d = json.loads(line)
            except Exception:
                continue
            who = (d.get("role") or d.get("from") or "").lower()
            direction = (d.get("dir") or d.get("direction") or "").lower()
            txt = (d.get("text") or d.get("content") or "").strip()
            if not txt:
                continue
            if direction:
                is_user = direction in ("in", "inbound")
                is_bot = not is_user
            else:
                is_user = who in ("user", "michael", "human")
                is_bot = who in ("assistant", "bot")
            if is_user:
                if cur:
                    yield cur
                cur = {"tool": "telegram", "project": "",
                       "at": d.get("ts", d.get("at", "")), "text": txt, "answers": []}
            elif is_bot and cur is not None:
                cur["answers"].append(txt)
    except (IOError, OSError):
        pass
    if cur:
        yield cur


TELEGRAM_TRANSCRIPT = "/var/lib/mc-telegram/transcript.jsonl"


# A message our own machinery put into a chat wearing the human's role. The courier hands a
# desk a "[WORK ORDER from the company ...]", the compressor injects "[CONTEXT COMPACTION -
# REFERENCE ONLY]", a scheduled run opens with "[IMPORTANT: You are running as ...]". None of
# those is a thing you typed, and archiving them would fill the drawer with a program's words.
# The tell is the shouted opening tag: our machinery announces itself in capitals inside
# square brackets, and a human does not. So a name label like "[Sam] ..." survives, and so does
# a quote wrapper like '[Replying to: "x"]', because those are your own words with a label
# glued on the front. The label comes off below, so a search for the first word you typed finds it.
MACHINE_BANNER = re.compile(r"^\[[A-Z][A-Z0-9 ]{2,}")

# Some chat bridges glue the speaker's name in front of every message. It is not part of the
# prompt, so it comes off. The machine-banner test above has already run, so a shouted tag is
# gone by now and this can only ever strip an ordinary name.
SPEAKER_LABEL = re.compile(r"^\[[A-Z][A-Za-z ]{0,20}\]\s*")


def hermes_home():
    """Where Hermes keeps its own store of conversations.

    Hermes is the assistant this book teaches from Chapter 3 (since 2026-09-02), and every
    conversation you have with it, on the desktop app or in a terminal, lives in a small
    sqlite database in Hermes' own folder and nowhere else. That folder is HERMES_HOME when
    Hermes is told one (the Windows desktop app sets it to %LOCALAPPDATA%/hermes), else
    the platform default. The DEFAULT profile keeps its store at the root of that folder as
    state.db; every other profile keeps its own under profiles/<name>/state.db.

    GODSPEED_HERMES_HOME wins so a test can point at a fixture. Then HERMES_HOME, then the
    Windows default, then a server-wide install, then this user's own, then nothing at all,
    which is the correct answer on a computer that never ran Hermes.
    """
    env = os.environ.get("GODSPEED_HERMES_HOME")
    if env:
        return env
    candidates = []
    if os.environ.get("HERMES_HOME"):
        candidates.append(os.environ["HERMES_HOME"])
    if os.environ.get("LOCALAPPDATA"):
        candidates.append(os.path.join(os.environ["LOCALAPPDATA"], "hermes"))
    candidates += ["/home/hermes/.hermes", os.path.join(home_dir(), ".hermes")]
    for c in candidates:
        if os.path.isfile(os.path.join(c, "state.db")) or os.path.isdir(os.path.join(c, "profiles")):
            return c
    return None


def hermes_stores(hermes):
    """Every (label, path) pair of a Hermes session store under one home: the default
    profile's state.db at the root, labelled 'default', then profiles/<name>/state.db."""
    if not hermes:
        return []
    out = []
    root = os.path.join(hermes, "state.db")
    if os.path.isfile(root):
        out.append(("default", root))
    for db in sorted(glob.glob(os.path.join(hermes, "profiles", "*", "state.db"))):
        out.append((os.path.basename(os.path.dirname(db)), db))
    return out


def human_turns_hermes_store(hermes):
    """Everything you typed to EVERY chat bot on this machine, from the bots' own store.

    WHY THIS EXISTS. This used to harvest exactly one bot, and only because a separate
    nightly job exported that one bot's conversations into a single file whose path was
    written into the code above. Every other bot on the same machine had no such job and no
    such file, so every word typed to any of them was kept nowhere: on the machine where this
    was found, eight bots and 281 prompts, with nothing anywhere saying so.

    The shape of that bug is the point. A source you reach through a per-bot file is a source
    somebody has to remember to plumb, once per bot, for ever, and the day a new bot appears
    it starts losing your words in silence. So this does not read a file that another job
    writes. It reads the place the bots themselves write: profiles/<name>/state.db, one small
    sqlite database per bot, holding its conversations and their messages. A bot made
    tomorrow is covered tomorrow, with nothing to install and nothing to remember.

    Only conversations a PERSON had are read: source 'desktop' (the Hermes desktop app),
    'cli' (a terminal session) and 'telegram' (the messenger). The other sources in that same
    database (api_server, cron, webhook) are programs giving Hermes work, and their "user"
    turns are prompts a program wrote, which is not your history.

    The bot's replies ride along as the answer of the turn they follow. Rows are ordered by
    session, then timestamp, then insertion order, because a busy bot writes several messages
    within the same second and the insertion-order tiebreak is what keeps a reply attached to
    its own question. A machine-banner turn still swallows the replies that follow it: they
    answer the machinery, not the person, so they must never leak backward onto a real turn.
    """
    import sqlite3  # only needed here, and only on a machine that runs Hermes
    if not hermes:
        return
    for bot, db in hermes_stores(hermes):
        try:
            # Read-only, so a live bot writing to the same database is never disturbed.
            con = sqlite3.connect("file:" + db.replace("?", "%3f") + "?mode=ro", uri=True)
            rows = con.execute(
                "SELECT m.session_id, m.timestamp, m.role, m.content, s.source FROM messages m "
                "JOIN sessions s ON s.id = m.session_id "
                "WHERE s.source IN ('telegram', 'desktop', 'cli') AND m.role IN ('user', 'assistant') "
                "ORDER BY m.session_id, m.timestamp, m.rowid").fetchall()
            con.close()
        except Exception as e:
            # Loud on purpose. A bot we cannot read is a bot whose prompts are being lost,
            # and the whole lesson of this file is that such a loss must never be silent.
            print("  NOTE: could not read the store of the '%s' bot (%s), so what you typed "
                  "to it is NOT being archived." % (bot, e))
            continue
        cur, cur_sid = None, None
        for sid, ts, role, txt, channel in rows:
            if sid != cur_sid:
                if cur:
                    yield cur
                cur, cur_sid = None, sid
            txt = (txt or "").strip()
            if role == "user":
                if cur:
                    yield cur
                cur = None
                if not txt or MACHINE_BANNER.match(txt):
                    continue
                txt = SPEAKER_LABEL.sub("", txt).strip()
                if not txt:
                    continue
                try:
                    at = datetime.fromtimestamp(float(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
                except Exception:
                    at = ""
                # "tool" says which assistant this was said to, "project" which profile of it,
                # and "channel" through which door: desktop, cli or telegram. Until 2026-09-02
                # every entry from this store said "telegram", which was a lie for a desktop chat.
                cur = {"tool": "hermes", "project": bot, "channel": channel, "at": at,
                       "text": txt, "answers": []}
            elif cur is not None and txt:
                cur["answers"].append(txt)
        if cur:
            yield cur


def harvest(godspeed):
    """Every source the person has switched ON. A source that is off is not read at
    all, rather than read-and-discarded: the promise to the person is that this
    program does not open that tool's files, not that it forgets what it saw."""
    home = home_dir()
    on = enabled_sources()
    if "claude" in on:
        yield from human_turns_claude(glob.glob(os.path.join(home, ".claude", "projects", "*", "*.jsonl")))
    if "codex" in on:
        codex = os.path.join(home, ".codex", "sessions")
        yield from human_turns_codex([os.path.join(r, f) for r, _d, fs in os.walk(codex)
                                      for f in fs if f.endswith(".jsonl")])
    if "hermes" in on:
        # Overridable so a test can point it at a fixture. A path compiled into the code is a
        # path no test can reach, which is exactly how the "dir" bug above survived.
        yield from human_turns_hermes(os.environ.get("GODSPEED_TELEGRAM_TRANSCRIPT") or TELEGRAM_TRANSCRIPT)
        # Kept alongside the line above rather than replacing it: that file carries chat from
        # before the current store existed, and the two overlap harmlessly because a prompt is
        # recognised by its text, so whichever reader reaches it first is the only one that counts.
        yield from human_turns_hermes_store(hermes_home())


# --------------------------------------------------------------------- storage

def archive_dir(godspeed):
    return os.path.join(godspeed, "prompts", "archive")


def library_files(godspeed):
    """The saved prompts, which is every .md in the shelf EXCEPT its own front door.

    prompts/README.md and prompts/library/README.md explain the drawers to a human. They are
    not prompts, and counting them as prompts would put the explanation itself in every
    search result and inflate `stats` by two.
    """
    out = []
    for f in sorted(glob.glob(os.path.join(godspeed, "prompts", "library", "*.md"))):
        if os.path.basename(f).lower() in ("readme.md", "index.md"):
            continue
        out.append(f)
    return out


def lock_or_exit(godspeed):
    """One harvest at a time on one machine.

    Three things now start a harvest (a session ending, the daily task, a human proving it
    works), so two can overlap. Both would read the same seen-set, find the same new prompts
    and append them twice, because the file is opened in append mode. An exclusive lock file
    is the cheapest fix that works on Windows and Linux alike. A stale lock older than an
    hour is ignored: a crashed run must not switch the harvest off for ever.
    """
    os.makedirs(archive_dir(godspeed), exist_ok=True)
    p = os.path.join(archive_dir(godspeed), ".harvest.lock")
    try:
        if os.path.isfile(p) and (datetime.now(timezone.utc).timestamp() - os.path.getmtime(p)) > 3600:
            os.remove(p)
    except OSError:
        pass
    try:
        fd = os.open(p, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except OSError:
        return None
    return p


def load_seen(godspeed):
    seen = set()
    for f in sorted(glob.glob(os.path.join(archive_dir(godspeed), "*.jsonl"))):
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                try:
                    seen.add(json.loads(line)["id"])
                except Exception:
                    continue
        except (IOError, OSError):
            continue
    return seen


def month_of(at):
    if at and len(at) >= 7 and at[4] == "-":
        return at[:7]
    return datetime.now(timezone.utc).strftime("%Y-%m")


def cmd_harvest(godspeed, dry, since, machine):
    lock = None
    if not dry:
        lock = lock_or_exit(godspeed)
        if lock is None:
            print("another harvest is already running on this machine, so this one did nothing")
            return 0
    try:
        return _harvest_locked(godspeed, dry, since, machine)
    finally:
        if lock:
            try:
                os.remove(lock)
            except OSError:
                pass


def _harvest_locked(godspeed, dry, since, machine):
    terms = redact_terms()
    seen = load_seen(godspeed)
    buckets, added, dropped, dupes = {}, 0, 0, 0
    patch = {}
    for rec in harvest(godspeed):
        if since and (rec["at"] or "")[:10] < since:
            continue
        rid = hashlib.sha256(("%s|%s" % (rec["tool"], rec["text"])).encode("utf-8")).hexdigest()[:16]
        ans = join_answer(rec.get("answers") or [])
        if rid in seen:
            dupes += 1
            # A prompt harvested before its reply finished sits in the archive without an
            # answer, and this dedup would keep it that way for ever. So a duplicate that
            # NOW carries an answer is remembered, and the stored row is patched after the
            # write. Yesterday's last prompt gets its answer on today's run, by itself.
            if ans and len(ans) > len(patch.get(rid, "")):
                patch[rid] = ans
            continue
        clean, why = scrub(rec["text"], terms)
        if clean is None:
            dropped += 1
            continue
        seen.add(rid)
        row = {"id": rid, "at": rec["at"][:19], "machine": machine, "tool": rec["tool"],
               "project": rec["project"], "text": clean}
        if rec.get("channel"):
            row["channel"] = rec["channel"]  # which door: desktop, cli or telegram
        if ans:
            pa = prepare_answer(ans, terms)
            if pa:
                row["answer"] = pa
        buckets.setdefault(month_of(rec["at"]), []).append(row)
        added += 1

    healed = 0
    if not dry:
        os.makedirs(archive_dir(godspeed), exist_ok=True)
        for month, rows in sorted(buckets.items()):
            p = os.path.join(archive_dir(godspeed), "%s-%s.jsonl" % (machine, month))
            with io.open(p, "a", encoding="utf-8", newline="\n") as fh:
                for r in sorted(rows, key=lambda r: r["at"]):
                    fh.write(json.dumps(r, ensure_ascii=False) + "\n")
        if patch:
            healed = attach_answers(godspeed, patch, terms, False)

    print("%s %d prompt%s from this machine (%s)"
          % ("would archive" if dry else "archived", added, "" if added == 1 else "s", machine))
    for month, rows in sorted(buckets.items()):
        print("  %s-%s.jsonl  +%d" % (machine, month, len(rows)))
    print("  %d skipped: already archived, or the same thing typed twice" % dupes)
    if healed:
        print("  %d earlier prompt%s got %s answer attached"
              % (healed, "" if healed == 1 else "s", "its" if healed == 1 else "their"))
    off = sorted(set(SUPPORTED_SOURCES) - enabled_sources())
    if off:
        print("  not read, by your choice: %s" % ", ".join(off))
    if dropped:
        print("  %d dropped: still looked like a credential after scrubbing" % dropped)
    if not terms:
        print("\n  NOTE: no name list configured, so only key-shaped text was removed.")
        print("  To also strip employer or client names: put one per line in ~/.godspeed/redact.txt")
        print("  (that file is never committed), or set GODSPEED_REDACT_TERMS in the secrets store.")
    return 0


def attach_answers(godspeed, answer_map, terms, dry):
    """Write answers onto rows that are already archived and have none.

    ANY machine's monthly file may hold the row: prompts are deduplicated across the
    fleet, so a prompt first archived from one machine can have its transcript here.
    The rewrite goes through a temporary file and an atomic replace, because these
    files are appended to by harvests and synced by git, and a half-written monthly
    file would be seen by both."""
    updated = 0
    for f in sorted(glob.glob(os.path.join(archive_dir(godspeed), "*.jsonl"))):
        out, file_changed = [], False
        try:
            src = io.open(f, encoding="utf-8", errors="replace")
        except (IOError, OSError):
            continue
        with src:
            for line in src:
                line = line.rstrip("\n")
                if not line.strip():
                    continue
                try:
                    r = json.loads(line)
                except Exception:
                    out.append(line)
                    continue
                if r.get("id") in answer_map and not r.get("answer"):
                    pa = prepare_answer(answer_map[r["id"]], terms)
                    if pa:
                        r["answer"] = pa
                        line = json.dumps(r, ensure_ascii=False)
                        file_changed = True
                        updated += 1
                out.append(line)
        if file_changed and not dry:
            tmp = f + ".tmp"
            with io.open(tmp, "w", encoding="utf-8", newline="\n") as fh:
                fh.write("\n".join(out) + "\n")
            os.replace(tmp, f)
    return updated


def cmd_backfill(godspeed, dry):
    """Attach answers to prompts archived before answers existed.

    The harvest has kept each prompt's answer only since the feature shipped; every
    row from before is answer-less, while the transcript holding its answer is still
    on the machine that made it - until the tool prunes it, which every tool does.
    So this walks this machine's transcripts once, finds the turns whose prompts are
    archived without an answer, and writes the answers in. Running it twice changes
    nothing: a row that has its answer is never a candidate again."""
    lock = None
    if not dry:
        lock = lock_or_exit(godspeed)
        if lock is None:
            print("another harvest is already running on this machine, so this one did nothing")
            return 0
    try:
        terms = redact_terms()
        wanted, total = set(), 0
        for r in all_rows(godspeed):
            total += 1
            if not r.get("answer"):
                wanted.add(r.get("id"))
        answers = {}
        for rec in harvest(godspeed):
            rid = hashlib.sha256(("%s|%s" % (rec["tool"], rec["text"])).encode("utf-8")).hexdigest()[:16]
            if rid not in wanted:
                continue
            ans = join_answer(rec.get("answers") or [])
            if ans and len(ans) > len(answers.get(rid, "")):
                answers[rid] = ans
        updated = attach_answers(godspeed, answers, terms, dry)
        print("%s answers onto %d of %d answer-less archived prompts (%d archived in all)"
              % ("would write" if dry else "wrote", updated, len(wanted), total))
        left = len(wanted) - updated
        if left:
            print("  %d still have no answer here: the transcript is gone, or lives on "
                  "another machine - run `godspeed prompts backfill` there too" % left)
        if updated and not dry:
            print("Commit prompts/archive/ so every machine gets the answers.")
        return 0
    finally:
        if lock:
            try:
                os.remove(lock)
            except OSError:
                pass


def cmd_rescrub(godspeed, dry):
    """Run today's scrubber over what is ALREADY in the archive.

    WHY THIS EXISTS. The scrubber only ever ran at the moment a prompt was written, so the
    name list protected the future and nothing else. The day you add your employer to
    ~/.godspeed/redact.txt, every prompt already in the repository still carries it. That is the
    wrong way round: the list is exactly the thing you discover you needed AFTER the fact.

    A row that is now clean is rewritten. A row that now looks like a credential is dropped
    whole, same rule as the harvest: losing one prompt costs one prompt.
    """
    terms = redact_terms()
    if not terms:
        print("no name list found, so a rescrub would only redo the key-shaped patterns.")
        print("Put one name per line in %s (never committed), or set GODSPEED_REDACT_TERMS."
              % os.path.join(home_dir(), ".godspeed", "redact.txt"))
    changed = dropped = total = 0
    for f in sorted(glob.glob(os.path.join(archive_dir(godspeed), "*.jsonl"))):
        out, file_changed = [], False
        for line in io.open(f, encoding="utf-8", errors="replace"):
            line = line.rstrip("\n")
            if not line.strip():
                continue
            try:
                r = json.loads(line)
            except Exception:
                out.append(line)
                continue
            total += 1
            clean, why = scrub(r.get("text", ""), terms)
            if clean is None:
                dropped += 1
                file_changed = True
                continue
            if clean != r.get("text"):
                r["text"] = clean
                changed += 1
                file_changed = True
            # The answer is rescrubbed with the answer rule (lose the line, keep the
            # reply), or the redact list would clean the prompts and leave the same
            # name sitting in every answer beside them.
            if r.get("answer"):
                na = scrub_answer(r["answer"], terms)
                if na != r["answer"]:
                    if na:
                        r["answer"] = na
                    else:
                        del r["answer"]
                    changed += 1
                    file_changed = True
            out.append(json.dumps(r, ensure_ascii=False))
        if file_changed and not dry:
            with io.open(f, "w", encoding="utf-8", newline="\n") as fh:
                fh.write("\n".join(out) + "\n")
    print("%s %d of %d archived prompts: %d cleaned, %d dropped whole"
          % ("would change" if dry else "changed", changed + dropped, total, changed, dropped))
    if not dry and (changed or dropped):
        print("Commit prompts/archive/ so every machine gets the cleaned copy.")
    return 0


def cmd_sources(godspeed, machine):
    """Every place on THIS machine that you type to an AI, and whether it reaches the drawer.

    WHY THIS COMMAND EXISTS. The guard we already had counts prompts per MACHINE, and it was
    green throughout the failure it was written to catch a milder version of. The server was
    archiving every day, from its Claude sessions and one bot, so 'the server is contributing'
    was true while eight other bots on that same machine were losing every word typed
    to them. Counting machines cannot see a missing SOURCE, because a machine with one working
    source looks exactly like a machine with all of them.

    So this measures the property directly: read what this machine can see, one source at a
    time, and ask of each one whether the archive already holds it. A source with prompts in
    it and none of them archived is a leak, and there is no innocent reading of that.

    Exit 0 = every source this machine has is represented, 1 = at least one is not.
    """
    seen = load_seen(godspeed)
    have, total, newest = {}, {}, {}
    for rec in harvest(godspeed):
        key = (rec["tool"], rec["project"] if rec["tool"] in ("telegram", "hermes") else "")
        rid = hashlib.sha256(("%s|%s" % (rec["tool"], rec["text"])).encode("utf-8")).hexdigest()[:16]
        total[key] = total.get(key, 0) + 1
        if rid in seen:
            have[key] = have.get(key, 0) + 1
        at = (rec["at"] or "")[:10]
        if at > newest.get(key, ""):
            newest[key] = at

    # A source switched off is silent in the numbers above because it was never read.
    # Said out loud here so its silence reads as the person's choice, not as a leak:
    # the selftest that runs this command must not alarm on a decision.
    off = sorted(set(SUPPORTED_SOURCES) - enabled_sources())

    if not total:
        if off:
            print("switched off by your choice, so not read at all: %s" % ", ".join(off))
        print("this machine has no readable AI session logs, so there is nothing here to archive.")
        return 0

    print("what this machine (%s) can see, and whether the archive has it:" % machine)
    if off:
        print("  (switched off by your choice, so not read at all: %s)" % ", ".join(off))
    leaks = []
    for key in sorted(total, key=lambda k: -total[k]):
        name = key[0] + ("/" + key[1] if key[1] else "")
        n, h = total[key], have.get(key, 0)
        print("  %-28s %6d typed   %6d archived   newest %s"
              % (name, n, h, newest.get(key) or "undated"))
        if h == 0:
            leaks.append((name, n))

    for name, n in leaks:
        print("PROMPT SOURCE LOST: %d prompt%s typed into '%s' on this machine, and not one of "
              "them is in the archive. Everything you say there is being thrown away. Run "
              "`godspeed prompts archive` here and read what it says."
              % (n, "" if n == 1 else "s", name))
    return 1 if leaks else 0


def all_rows(godspeed):
    for f in sorted(glob.glob(os.path.join(archive_dir(godspeed), "*.jsonl"))):
        try:
            for line in io.open(f, encoding="utf-8", errors="replace"):
                try:
                    yield json.loads(line)
                except Exception:
                    continue
        except (IOError, OSError):
            continue


def cmd_search(godspeed, terms, limit):
    if not terms:
        sys.stderr.write("usage: godspeed prompts search <term> [<term>...]\n"); return 1
    low = [t.lower() for t in terms]
    hits, total = [], 0
    for r in all_rows(godspeed):
        total += 1
        hay = (r.get("text", "") + "\n" + r.get("answer", "")).lower()
        n = sum(1 for x in low if x in hay)
        if n:
            hits.append((n, hay.count(low[0]), r))

    lib = []
    for f in library_files(godspeed):
        body = io.open(f, encoding="utf-8", errors="replace").read()
        if all(x in body.lower() for x in low):
            lib.append((os.path.basename(f)[:-3], body))

    if not hits and not lib:
        print("nothing you have typed to any AI matches %s." % " + ".join(terms))
        print("That is a checked absence, not an error. The archive covers what has been")
        print("harvested so far: run `godspeed prompts archive` on a machine to add its history.")
        return 0

    if lib:
        print("SAVED PROMPTS (%d):" % len(lib))
        for name, body in lib[:limit]:
            purpose = re.search(r"^purpose:\s*\"?(.+?)\"?$", body, re.M)
            print("  %s%s" % (name, " - " + purpose.group(1) if purpose else ""))
            print("     read it: godspeed prompts get %s" % name)
        print("")

    hits.sort(key=lambda h: (-h[0], -h[1], h[2].get("at", "")))
    print("THINGS YOU TYPED (%d of %d match, showing %d):"
          % (len(hits), total, min(limit, len(hits))))
    for _n, _c, r in hits[:limit]:
        when = (r.get("at") or "")[:10] or "undated"
        where = "%s/%s" % (r.get("machine", "?"), r.get("tool", "?"))
        txt = " ".join(r.get("text", "").split())
        if len(txt) > 240:
            txt = txt[:237] + "..."
        print("\n  %s  %s%s" % (when, where, "  [%s]" % r["project"] if r.get("project") else ""))
        print("  Q: %s" % txt)
        # When the hit is in what the AI SAID, show that piece too, marked A:, or the
        # result would show a prompt with no visible reason it matched.
        ans = r.get("answer", "")
        ansl = ans.lower()
        hit_term = next((x for x in low if x in ansl), None)
        if hit_term:
            i = ansl.find(hit_term)
            start, end = max(0, i - 120), min(len(ans), i + len(hit_term) + 120)
            snip = " ".join(ans[start:end].split())
            print("  A: %s%s%s" % ("..." if start > 0 else "", snip,
                                   "..." if end < len(ans) else ""))
    if len(hits) > limit:
        print("\n(%d more; add --limit N)" % (len(hits) - limit))
    return 0


def cmd_get(godspeed, args):
    if not args:
        sys.stderr.write("usage: godspeed prompts get <name>\n"); return 1
    want = args[0].lower().removesuffix(".md")
    for f in library_files(godspeed):
        if os.path.basename(f)[:-3].lower() == want:
            sys.stdout.write(io.open(f, encoding="utf-8").read()); return 0
    part = [f for f in library_files(godspeed) if want in os.path.basename(f).lower()]
    if len(part) == 1:
        sys.stdout.write(io.open(part[0], encoding="utf-8").read()); return 0
    if part:
        print("'%s' matches %d saved prompts. Name one:" % (args[0], len(part)))
        for f in part:
            print("  %s" % os.path.basename(f)[:-3])
        return 1
    print("no saved prompt called '%s'. Try: godspeed prompts search %s" % (args[0], args[0]))
    return 1


def cmd_stats(godspeed):
    """What is in the archive, and WHICH MACHINE STOPPED SENDING.

    The count alone is what let this run for a month with only the work PC in it: 1,122
    prompts looks healthy until you notice every one is from the same computer. So the
    newest prompt per source is printed beside the count. A source whose newest prompt is
    weeks old is a harvest that has quietly stopped, and mc-selftest reads exactly this.
    """
    rows = list(all_rows(godspeed))
    by, last = {}, {}
    for r in rows:
        k = (r.get("machine", "?"), r.get("tool", "?"))
        by[k] = by.get(k, 0) + 1
        at = (r.get("at") or "")[:10]
        if at > last.get(k, ""):
            last[k] = at
    chars = sum(len(r.get("text", "")) for r in rows)
    withans = [r for r in rows if r.get("answer")]
    achars = sum(len(r["answer"]) for r in withans)
    print("archived prompts   %d  (%.1f MB of text)" % (len(rows), chars / 1e6))
    print("  with answers     %d  (%.1f MB of answers)" % (len(withans), achars / 1e6))
    print("  %-14s %-12s %8s  %s" % ("machine", "tool", "prompts", "newest"))
    for k, n in sorted(by.items(), key=lambda kv: -kv[1]):
        print("  %-14s %-12s %8d  %s" % (k[0], k[1], n, last.get(k) or "undated"))
    print("machines           %d" % len(set(m for m, _t in by)))
    print("saved prompts      %d  (prompts/library/)" % len(library_files(godspeed)))
    dates = sorted(r.get("at", "")[:10] for r in rows if r.get("at"))
    if dates:
        print("covers             %s to %s" % (dates[0], dates[-1]))
    return 0


def main(argv):
    args, godspeed_arg, dry, since, limit = [], None, False, None, 12
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--godspeed" and i + 1 < len(argv):
            godspeed_arg = argv[i + 1]; i += 2; continue
        if a == "--since" and i + 1 < len(argv):
            since = argv[i + 1]; i += 2; continue
        if a == "--limit" and i + 1 < len(argv):
            try:
                limit = max(1, int(argv[i + 1]))
            except ValueError:
                pass
            i += 2; continue
        if a in ("--dry-run", "-n"):
            dry = True; i += 1; continue
        args.append(a); i += 1

    godspeed = godspeed_root(godspeed_arg)
    machine = re.sub(r"[^a-z0-9]+", "-", (os.environ.get("GODSPEED_MACHINE") or socket.gethostname()).lower()).strip("-")
    cmd = args[0] if args else "archive"
    rest = args[1:]
    if cmd in ("archive", "harvest"):
        return cmd_harvest(godspeed, dry, since, machine)
    if cmd == "search":
        return cmd_search(godspeed, rest, limit)
    if cmd == "get":
        return cmd_get(godspeed, rest)
    if cmd == "stats":
        return cmd_stats(godspeed)
    if cmd == "sources":
        return cmd_sources(godspeed, machine)
    if cmd == "rescrub":
        return cmd_rescrub(godspeed, dry)
    if cmd == "backfill":
        return cmd_backfill(godspeed, dry)
    sys.stderr.write("usage: godspeed prompts archive | search <term> | get <name> | stats | sources | rescrub | backfill\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
