#!/usr/bin/env bash
# mc-research: every adopted goal's research, kept current, once a night.
#
# WHAT IT DOES. For each adopted outcome not yet researched today (mc-goals research --due, the
# ones researched longest ago first), it runs the goal-research recipe for that one goal through
# mc-run, then checks the night with mc-check-research --fetch. A night that falls short is sent
# back ONCE with the exact gaps. A night that still falls short, or never ran, leaves
# goals/research/<id>/days/<date>.gap.md, so a missing night can never read as a quiet one; a day
# record that failed its check is renamed <date>.unchecked.md so it does not count as a night.
#
# THE TIME BUDGET (--budget-minutes, default 130) bounds when the run FINISHES: a goal starts only
# if the time already used, plus its timeout (900 s daily, 2700 s founding), the 900 s fix round
# and the two checks that read tonight's quotes again (15 s a page, each check reading at most
# --fetch-quotes pages, default 20) still fits. Goals that do not fit are named in the summary and
# the run exits 1.
#
# IT NEVER CONTACTS ANYONE AND NEVER SPENDS, AND WRITES ONLY ITS OWN FOLDERS. The recipe only reads
# pages and writes files. With claude that is enforced: the shell is limited to the checker, the
# goals tool and two readers, the file tools may write only in goals/research/ and ideas/, and
# mc-run makes that list binding (claude --restricted, --permission-mode dontAsk), so settings on
# the computer that allow every command do not count, and nothing the night writes is a file a
# later run executes. Hermes and Codex take no tool list, so on a computer that runs them these
# limits rest on the recipe's wording alone (tools/README.md says why that risk is accepted).
#
# IT COMMITS ONLY ITS OWN FILES: the research folders, tonight's run folder (without the .tmp
# answer of a run still going), and the goal cards and ideas that changed while it ran. Other jobs
# write into goals/, ideas/ and routines/ too, and their half-written files are theirs to commit.
#
# RUN IT BY HAND:   mc-research            (or --only <id> for one goal, --dry-run to see the list)
# ONCE A NIGHT, before your daily decision (crontab -e):
#        15 0 * * *  $HOME/.local/bin/mc-research >> $HOME/.godspeed/research.log 2>&1
set -uo pipefail

GODSPEED=""; TODAY=""; BUDGET=130; ONLY=""; EXTRA=""; TD=900; TF=2700; DRY=0; FQ=20
while [ $# -gt 0 ]; do
  case "$1" in
    --godspeed) GODSPEED="$2"; shift 2 ;;
    --date) TODAY="$2"; shift 2 ;;
    --budget-minutes) BUDGET="$2"; shift 2 ;;
    --only) ONLY="$2"; shift 2 ;;
    --extra-prompt-file) EXTRA="$2"; shift 2 ;;
    --timeout-daily) TD="$2"; shift 2 ;;
    --timeout-founding) TF="$2"; shift 2 ;;
    --fetch-quotes) FQ="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
    *) echo "mc-research: I do not know the argument $1" >&2; exit 2 ;;
  esac
done

winpath() { if [ -n "$1" ] && command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s\n' "$1"; fi; }
looks_like_godspeed() { [ -d "${1:-}/rules" ] || [ -d "${1:-}/observations" ]; }
if [ -z "$GODSPEED" ]; then GODSPEED="${GODSPEED_ROOT:-}"; fi
if [ -z "$GODSPEED" ] || ! looks_like_godspeed "$GODSPEED"; then
  D="$PWD"; GODSPEED=""
  for _ in 1 2 3 4 5 6 7 8; do
    looks_like_godspeed "$D" && { GODSPEED="$D"; break; }
    P="$(dirname "$D")"; [ "$P" = "$D" ] && break; D="$P"
  done
fi
if [ -z "$GODSPEED" ] && [ -r "$HOME/.godspeed/device.env" ]; then
  GODSPEED="$(sed -n 's/^[[:space:]]*\(export[[:space:]]*\)\{0,1\}GODSPEED_DIR=//p' "$HOME/.godspeed/device.env" | tail -1 | tr -d '"'"'"' ' | tr -d '\r')"
fi
looks_like_godspeed "$GODSPEED" || { echo "mc-research: I could not find your mission control; pass --godspeed DIR." >&2; exit 2; }
GODSPEED="$(winpath "$GODSPEED")"
cd "$GODSPEED" || exit 2
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
[ -n "$TODAY" ] || TODAY="${GODSPEED_TODAY:-$(date -u +%Y-%m-%d)}"
HERE="$(winpath "$(cd "$(dirname "$0")" && pwd)")"
NODE=""; for c in node nodejs /usr/local/bin/node /usr/bin/node; do "$c" -e '' >/dev/null 2>&1 && { NODE="$c"; break; }; done
[ -n "$NODE" ] || { echo "mc-research: there is no Node.js on this computer." >&2; exit 1; }
GOALS="$HERE/goals.js"; [ -f "$GOALS" ] || GOALS="$HOME/.local/bin/goals.js"
CHECK="$HERE/check-research.js"; [ -f "$CHECK" ] || CHECK="$HOME/.local/bin/check-research.js"
RUNNER="$HERE/mc-run"; [ -f "$RUNNER" ] || RUNNER="$HOME/.local/bin/mc-run"
for f in "$GOALS" "$CHECK" "$RUNNER"; do [ -f "$f" ] || { echo "mc-research: $(basename "$f") is not installed." >&2; exit 3; }; done
g() { GODSPEED_ROOT="$GODSPEED" GODSPEED_TODAY="$TODAY" "$NODE" "$GOALS" "$@"; }
RUNDIR="$GODSPEED/routines/research/$TODAY"; mkdir -p "$RUNDIR"
SUMMARY="$RUNDIR/summary.txt"

DUE="$(g research --due --date "$TODAY" ${ONLY:+--only "$ONLY"})" || { echo "mc-research: could not read the due list" >&2; exit 1; }
if [ "$DRY" -eq 1 ]; then echo "Due tonight ($TODAY):"; printf '%s\n' "${DUE:-nothing}"; exit 0; fi
[ -n "$DUE" ] || { echo "$TODAY: nothing due" >> "$SUMMARY"; echo "nothing due $TODAY"; exit 0; }

# The assistant gets /dev/null as its input: the list of goals is read from descriptor 3 below,
# and an assistant that reads its standard input must never swallow the goals still to come.
# claude gets only these tools, so a research night cannot reach out through the shell: Bash is
# limited to the checker, the goals tool and two harmless readers (no `date`: as root, `date -s`
# sets the clock, and the prompt already says what day it is); the notebook may be searched and
# read, never written; files are written only in goals/research/ and ideas/. The mission control
# also holds what later runs execute with the whole shell (routines, scripts, recipes, hooks), so
# a bare Write or Edit would let a night plant a command there. Because the list limits the shell,
# mc-run makes it binding (claude --restricted, dontAsk): the computer's own settings cannot add
# to it, and whatever it does not allow is refused. mc-run passes the list as separate words, so
# each Bash(...) and Edit(...) pattern survives.
# The two Edit rules hold every file tool (Claude Code checks Write against the Edit rules and never
# reads a Write(...) rule). Their paths start with / (the folder the run starts in, the mission
# control), and mc-run writes them out as that folder's absolute path: a plain goals/research/**
# follows the assistant's cd, and on 2026-10-15 a night that began with `cd goals/research/<goal>`
# had every save refused.
# Hermes and Codex take no list; with them the read-only rule rests on the recipe's wording.
TOOLS="Bash(mc-check-research:*) Bash(mc-goals:*) Bash(ls:*) Bash(wc:*) Read Grep Glob Edit(/goals/research/**) Edit(/ideas/**) WebSearch WebFetch mcp__notebook__search_brain mcp__notebook__get_note"
# An mc-run from before 2026-10-13 passes the list without binding it, or binds it but approves
# every edit in the mission control. Said in the summary, so a night that was not held to its list
# never reads as one that was. A run whose claude could not be held says so in its .stderr.
NOTED=0
not_held() { [ "$NOTED" -eq 1 ] && return 0; NOTED=1; echo "note: tonight's research was not held to its list of tools, because $1" >> "$SUMMARY"; }
grep -q -- 'dontAsk' "$RUNNER" 2>/dev/null || not_held "$RUNNER is older than mc-research; update both together"
# What a night may commit: the research folders and tonight's run folder, and the goal cards and
# ideas that changed while it ran. Other jobs write into goals/, ideas/ and routines/ as well, and
# what they leave half-written is theirs to commit. So the cards and ideas are fingerprinted now
# and again at the end, and only the ones that changed in between go into the night's commit.
fingerprints() {
  ( cd "$GODSPEED" 2>/dev/null || exit 0
    for f in goals/*.md; do [ -f "$f" ] && cksum "$f"; done
    [ -d ideas ] && find ideas -type f -exec cksum {} +
  ) 2>/dev/null | LC_ALL=C sort
}
FP_BEFORE="$(fingerprints)"
# The summary line is the answer's LAST paragraph: an assistant that worked with helpers writes
# "the helpers are still working" before its one plain final sentence, and only that sentence is
# the night's answer. At most 400 characters, never cut inside a letter.
last_paragraph() {
  "$NODE" -e 'const fs=require("fs");let t="";try{t=fs.readFileSync(process.argv[1],"utf8")}catch(e){}
const p=t.replace(/\r/g,"").split(/\n[ \t]*\n/).map(s=>s.replace(/\s+/g," ").trim()).filter(Boolean);
process.stdout.write(Array.from(p.length?p[p.length-1]:"").slice(0,400).join(""));' "$1"
}
recipe() { # prompt timeout out
  if [ -n "$EXTRA" ] && [ -f "$EXTRA" ]; then
    bash "$RUNNER" goal-research --godspeed "$GODSPEED" --cwd "$GODSPEED" --prompt-file "$EXTRA" --prompt "$1" \
      --timeout "$2" --out "$3" --allowed-tools "$TOOLS" < /dev/null || true
  else
    bash "$RUNNER" goal-research --godspeed "$GODSPEED" --cwd "$GODSPEED" --prompt "$1" \
      --timeout "$2" --out "$3" --allowed-tools "$TOOLS" < /dev/null || true
  fi
  # mc-run writes there when this computer's claude could not be held to the list.
  if grep -q "not held to its list of tools" "$3.stderr" 2>/dev/null; then
    not_held "$(grep -m1 "not held to its list of tools" "$3.stderr" | sed -E 's/^.*not held to its list of tools:? *//')"
  fi
}
# RECORDS IN ANOTHER SHAPE STILL COUNT (18 October 2026). A small model wrote every person, claim and
# opening of a founding night as one bullet line each, and the night counted none of them. After each
# run the program puts such records in their file's own form (mc-goals research <id> --tidy, goals.js
# tidyRecords) before the check reads them; what it did is kept beside the answer.
tidy() { g research "$1" --tidy >> "$RUNDIR/$1.tidy.txt" 2>&1 || true; }
count_people() { g research "$1" --state --json --date "$TODAY" 2>/dev/null | "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).people)}catch(e){console.log(0)}})'; }

START=$(date +%s); BAD=0; SKIPPED=""
while read -r ID MODE LAST <&3; do
  [ -n "$ID" ] || continue
  T="$TD"; [ "$MODE" = founding ] && T="$TF"
  # A goal starts only if its whole night still fits: the timeout, the 900 seconds of the fix round,
  # and the two checks with --fetch, each reading at most FQ pages at 15 seconds a page.
  if [ $(( $(date +%s) - START + T + 900 + 2 * FQ * 15 )) -gt $(( BUDGET * 60 )) ]; then
    SKIPPED="$SKIPPED $ID"
    # Said in the goal's own folder too, so a short night is never read as a quiet one.
    if [ -d "$GODSPEED/goals/research/$ID/days" ]; then
      printf '# %s %s: skipped for time

Written by mc-research. Tonight did not have time left for this goal, so it was not researched; it goes first tomorrow. This file does not count as a night.
' "$ID" "$TODAY"         > "$GODSPEED/goals/research/$ID/days/$TODAY.gap.md"
    fi
    continue
  fi
  g research "$ID" >/dev/null
  # Written BEFORE the run and removed only when the check passes: a run that is killed part way
  # (the computer slept, the scheduler stopped it) leaves this file, so the night is never read as done.
  GAPFILE="$GODSPEED/goals/research/$ID/days/$TODAY.gap.md"
  printf '# %s %s: started, not finished

Written by mc-research before the run so that a killed night is never read as done. It is removed when the night passes its check.
' "$ID" "$TODAY" > "$GAPFILE"
  BEFORE="$(count_people "$ID")"
  PROMPT="Today is $TODAY (UTC). Goal: $ID. Mode: $MODE. Its research folder is goals/research/$ID (last completed night: $LAST). Follow the goal-research recipe exactly for this one goal: update the files, rewrite brief.md with UPDATED: $TODAY, write goals/research/$ID/days/$TODAY.md, file the ideas the recipe asks for, and run mc-check-research --goal $ID --date $TODAY --mode $MODE --fetch until it prints OK. Your final answer is one plain sentence."
  recipe "$PROMPT" "$T" "$RUNDIR/$ID.answer.txt"
  tidy "$ID"
  CHK=(--godspeed "$GODSPEED" --goal "$ID" --date "$TODAY" --mode "$MODE" --before-people "$BEFORE" --fetch --fetch-max "$FQ")
  ANSWER="$RUNDIR/$ID.answer.txt"
  if ! GAPS="$("$NODE" "$CHECK" "${CHK[@]}" 2>&1)"; then
    FIX="Today is $TODAY (UTC). Goal: $ID. Mode: $MODE. Tonight's research for this goal is not finished; mc-check-research says:
$GAPS
Follow the goal-research recipe for exactly these gaps, in goals/research/$ID, and run the check again until it prints OK. Your final answer is one plain sentence."
    rm -f "$RUNDIR/$ID.answer-fix.txt"
    recipe "$FIX" 900 "$RUNDIR/$ID.answer-fix.txt"
    tidy "$ID"
    # The fix round's answer is the night's last word, so the summary takes it when there is one.
    [ -s "$RUNDIR/$ID.answer-fix.txt" ] && ANSWER="$RUNDIR/$ID.answer-fix.txt"
    GAPS="$("$NODE" "$CHECK" "${CHK[@]}" 2>&1)" || {
      # The day file is set aside, so a night that failed its check never counts as a night done.
      MOVED=""
      if [ -f "$GODSPEED/goals/research/$ID/days/$TODAY.md" ]; then
        mv "$GODSPEED/goals/research/$ID/days/$TODAY.md" "$GODSPEED/goals/research/$ID/days/$TODAY.unchecked.md" && MOVED="yes"
      fi
      { echo "# $ID $TODAY: the research night did not complete"; echo; echo "Written by mc-research so that a missing night is not read as a quiet one.${MOVED:+ The day record failed the check and was renamed days/$TODAY.unchecked.md, so it does not count as a night.} The check said:"; echo; echo "$GAPS"; } \
        > "$GODSPEED/goals/research/$ID/days/$TODAY.gap.md"
      echo "$ID: NOT COMPLETED ($MODE); see goals/research/$ID/days/$TODAY.gap.md" >> "$SUMMARY"
      printf '%s\n' "$GAPS" > "$RUNDIR/$ID.check.txt"
      BAD=$((BAD+1)); continue
    }
  fi
  printf '%s\n' "$GAPS" > "$RUNDIR/$ID.check.txt"
  rm -f "$GAPFILE"
  echo "$ID: done ($MODE): $(last_paragraph "$ANSWER")" >> "$SUMMARY"
done 3<<< "$DUE"
[ -n "$SKIPPED" ] && echo "skipped for time:$SKIPPED (they go first tomorrow)" >> "$SUMMARY"

if [ -d "$GODSPEED/.git" ] && command -v git >/dev/null 2>&1; then
  # Every file is named one by one, read literally. (An exclude pattern is no help: git 2.53 adds
  # nothing at all for `git add -A -- <one folder> ':(exclude)*.tmp'`.) A .tmp file is an answer
  # still being written by a night started by hand beside this one, so it is left out.
  gl() { git --literal-pathspecs -C "$GODSPEED" "$@"; }
  OWN=()
  own() { case "$1" in ''|*.tmp) ;; *) OWN+=("$1") ;; esac; }
  for d in goals/research "routines/research/$TODAY"; do
    [ -e "$GODSPEED/$d" ] || continue
    # Changed, new and deleted since the last commit, staged or not, and the files git has not
    # seen yet. (ls-files -m misses a change that is already staged.)
    while IFS= read -r -d '' f; do own "$f"; done < <(
      { gl diff -z --name-only HEAD -- "$d" 2>/dev/null || gl ls-files -z -m -d -- "$d" 2>/dev/null
        gl ls-files -z -o --exclude-standard -- "$d" 2>/dev/null; })
  done
  while IFS= read -r p; do own "$p"; done < <(
    LC_ALL=C comm -13 <(printf '%s\n' "$FP_BEFORE") <(fingerprints) | sed -E 's/^[0-9]+ [0-9]+ //')
  if [ "${#OWN[@]}" -gt 0 ]; then
    gl add -A -- "${OWN[@]}" >/dev/null 2>&1
    # Only paths git knows can be named to the commit (one it ignores would stop the whole commit).
    KNOWN=()
    for p in "${OWN[@]}"; do
      if gl ls-files --error-unmatch -- "$p" >/dev/null 2>&1 || gl cat-file -e "HEAD:$p" 2>/dev/null; then KNOWN+=("$p"); fi
    done
    if [ "${#KNOWN[@]}" -gt 0 ] && ! gl diff --cached --quiet -- "${KNOWN[@]}" 2>/dev/null; then
      # A new computer often has no Git name, and since 18 October 2026 a new mission control has its
      # first commit, so the night's commit was refused in silence there. It then carries the
      # notebook's name, as the conversation archive's commits do (prompt-harvest.js).
      if [ -z "$(gl config user.name 2>/dev/null)" ] || [ -z "$(gl config user.email 2>/dev/null)" ]; then
        export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-Godspeed Mission Control}" GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-godspeed@localhost}" \
          GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-Godspeed Mission Control}" GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-godspeed@localhost}"
      fi
      # The paths are named, so a file another job staged stays staged for that job's own commit.
      gl commit -q -m "Research $TODAY" -- "${KNOWN[@]}" >/dev/null 2>&1 || true
      gl remote get-url origin >/dev/null 2>&1 && gl push -q origin HEAD >/dev/null 2>&1 || true
    fi
  fi
fi
cat "$SUMMARY"
[ "$BAD" -eq 0 ] && [ -z "$SKIPPED" ]
