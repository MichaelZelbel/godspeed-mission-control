#!/usr/bin/env bash
# mc-work-run: carries out the work your mission control filed for itself, one item per assistant run, and
# lets a check that is not the runner say whether it got done.
#
# WHY THIS EXISTS. The daily decision (`mc-decide`) files what Mission Control will do for your goals:
# research how a goal is won, build a measurement, compute a number, draft a thing, find a
# person. Then it has a few minutes left in its own run, so only the two-minute items ever got
# done and everything that takes real work sat on the register as "planned" until it went stale.
# A plan nobody carries out is a to-do list. This program is the carrying out.
#
# HOW IT WORKS. It asks the work register for what is runnable now (planned, or a failed item
# whose retry day has come; never outward work, never something waiting on you), takes ONE item
# under a lease, gives the assistant the item, the goal it serves, how that goal is won (the
# playbook) and the newest diagnosis, and lets it work with a time limit. What the assistant
# says it did is recorded as ATTEMPTED. Then the item's own CHECK is run, and only that check
# makes it VERIFIED. An item that cannot be done from this machine is reported as failed with
# the reason, and gets its retry gap from the register, not a hammer. Then the next item.
#
# IT NEVER MESSAGES YOU AND IT NEVER POSTS. A finished piece becomes at most one card on the
# attention ledger if this mission control has one, and the ledger's own rules decide whether and when it
# reaches you.
#
# WHAT IT NEEDS: node, the `mc-work` register, `mc-run` and a `work-item` recipe in your mission control.
# `mc-goals` is used when it is there, for the goal's own words and its playbook.
#
# RUN IT BY HAND:        mc-work-run
# SEE WHAT WOULD RUN:    mc-work-run --dry-run
# ONE ITEM ONLY:         mc-work-run --only W-20260915-03
# TWICE A DAY, in your schedule (`crontab -e`), after the morning message and once after lunch:
#        45 7  * * *  $HOME/.local/bin/mc-work-run >> $HOME/.godspeed/work.log 2>&1
#        10 13 * * *  $HOME/.local/bin/mc-work-run >> $HOME/.godspeed/work.log 2>&1
#
# OPTIONS
#   --godspeed DIR               Mission Control folder (else found the usual way)
#   --date YYYY-MM-DD       the day the run is recorded under (default today, UTC)
#   --max-items N           at most N items in one run (default 2)
#   --budget SECONDS        stop starting new items after this long (default 2700)
#   --item-timeout SECONDS  time limit for one assistant run (default 1500)
#   --only <id>             run this one item and nothing else
#   --extra-prompt-file F   your mission control's own additions to the recipe, added for this run only
#   --publish-cmd "<cmd>"   a command that turns a finished file into an https page and prints
#                           the address; run as: <cmd> <file> --title "<what>"
#   --dry-run               list what would run; take nothing, run nothing, write nothing
set -uo pipefail

GODSPEED=""; DRY=0; TODAY=""; MAX=2; BUDGET=2700; ITEM_TIMEOUT=1500; ONLY=""; EXTRA=""; PUBLISH_CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --godspeed) GODSPEED="$2"; shift 2 ;;
    --date) TODAY="$2"; shift 2 ;;
    --max-items) MAX="$2"; shift 2 ;;
    --budget) BUDGET="$2"; shift 2 ;;
    --item-timeout) ITEM_TIMEOUT="$2"; shift 2 ;;
    --only) ONLY="$2"; shift 2 ;;
    --extra-prompt-file) EXTRA="$2"; shift 2 ;;
    --publish-cmd) PUBLISH_CMD="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
    *) echo "mc-work-run: I do not know the argument $1" >&2; exit 2 ;;
  esac
done

looks_like_godspeed() { [ -d "${1:-}/rules" ] || [ -d "${1:-}/observations" ]; }
if [ -z "$GODSPEED" ]; then GODSPEED="${GODSPEED_ROOT:-}"; fi
if [ -z "$GODSPEED" ] || ! looks_like_godspeed "$GODSPEED"; then
  D="$PWD"; GODSPEED=""
  for _ in 1 2 3 4 5 6 7 8; do
    looks_like_godspeed "$D" && { GODSPEED="$D"; break; }
    P="$(dirname "$D")"; [ "$P" = "$D" ] && break; D="$P"
  done
fi
if [ -z "$GODSPEED" ] && [ -r "$HOME/.godspeed/device.env" ]; then
  GODSPEED="$(sed -n 's/^[[:space:]]*\(export[[:space:]]*\)\{0,1\}GODSPEED_DIR=//p' "$HOME/.godspeed/device.env" | tail -1 | tr -d '"'"'"' ' | tr -d '\r')"
fi
if [ -z "$GODSPEED" ] || ! looks_like_godspeed "$GODSPEED"; then
  echo "mc-work-run: I could not find your mission control. Run this inside it, or pass --godspeed /path/to/godspeed." >&2
  exit 2
fi
cd "$GODSPEED" || exit 2
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
[ -n "$TODAY" ] || TODAY="${GODSPEED_TODAY:-$(date -u +%Y-%m-%d)}"
RUNDIR="$GODSPEED/routines/work/$TODAY"
HERE="$(cd "$(dirname "$0")" && pwd)"
ts() { date -u +%H:%M:%SZ; }
log() { echo "$(ts) $*"; }

# FIND NODE BY RUNNING IT, NEVER BY FINDING IT (the python3 stub on Windows prints an advert).
NODE=""
for c in node nodejs /usr/local/bin/node /usr/bin/node; do
  "$c" -e '' >/dev/null 2>&1 && { NODE="$c"; break; }
done
[ -n "$NODE" ] || { echo "mc-work-run: there is no Node.js on this computer, so nothing could be run." >&2; exit 1; }

MISSING=""
reg() {
  local name="$1"; shift
  local bin="$HERE/$name.js"
  [ -f "$bin" ] || bin="$HOME/.local/bin/$name.js"
  if [ ! -f "$bin" ]; then
    case " $MISSING " in *" mc-$name "*) : ;; *) MISSING="$MISSING mc-$name" ;; esac
    return 1
  fi
  GODSPEED_ROOT="$GODSPEED" "$NODE" "$bin" "$@"
}
reg work help >/dev/null 2>&1 || { echo "mc-work-run: mc-work is not installed, so there is no register to run from." >&2; exit 1; }

# TIME PASSES FIRST, AND A DRY RUN DOES NOT MOVE IT. `tick` returns dead leases and marks old
# plans stale; those lines carry today's date for ever. A dry run that quietly aged the register
# while saying "nothing was written" is the exact lie this register exists to refuse.
if [ "$DRY" -eq 1 ]; then reg work list >/dev/null 2>&1 || true
else reg work tick 2>/dev/null | sed 's/^/tick: /'; fi

# WHAT IS RUNNABLE, IN WHAT ORDER. The register already leaves out outward work, work waiting on
# a person or a missing capability, retries whose day has not come, and anything under a live
# lease. This program adds one rule of order: an item whose job is to find out how a goal is won
# (KIND learn, a playbook) goes before the doing, because doing without knowing how it is won is
# what this whole arrangement exists to stop. After that, the order they were filed in.
ORDER_SCRIPT='
let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
  let rows=[]; try { rows=JSON.parse(s); } catch(e) { rows=[]; }
  const only=process.argv[1]||"";
  if (only) rows=rows.filter(r=>r.id===only);
  const learn=(r)=>String(r.KIND||"do")==="learn";
  const play=(r)=>learn(r)&&/playbooks\//.test(String(r["DONE WHEN"]||""));
  rows.sort((a,b)=>(play(b)-play(a))||(learn(b)-learn(a))||String(a.id).localeCompare(String(b.id)));
  for (const r of rows) console.log(r.id+"\t"+(r.KIND||"do")+"\t"+(r.WHAT||""));
});'
ORDER_IDS="$(reg work next --json 2>/dev/null | "$NODE" -e "$ORDER_SCRIPT" "$ONLY")"

if [ -z "$ORDER_IDS" ]; then
  [ -n "$ONLY" ] && log "$ONLY is not runnable now (not planned, waiting on someone, outward, or under a lease)"
  log "nothing runnable now"
  [ -n "$MISSING" ] && log "not on this computer:$MISSING"
  exit 0
fi
if [ "$DRY" -eq 1 ]; then
  echo "Would run, in this order (at most $MAX):"
  printf '%s\n' "$ORDER_IDS" | sed 's/^/  /'
  echo "Nothing was taken, run or written."
  exit 0
fi

RUNNER="$HERE/mc-run"
[ -x "$RUNNER" ] || RUNNER="$HOME/.local/bin/mc-run"
[ -x "$RUNNER" ] || { echo "mc-work-run: mc-run is not installed, so no recipe could be carried out." >&2; exit 3; }

# The newest file for a goal in a folder, by name (they carry the date), or nothing.
newest() { ls -1 "$1"/"$2"-*.md 2>/dev/null | sort | tail -1; }
field() { printf '%s\n' "$1" | sed -n "s/^$2: //p" | head -1; }
# The first thing in DONE WHEN that looks like a file in the godspeed: a path with a slash and a
# plain-text extension. That file is what gets published when the item verifies.
path_in() { printf '%s\n' "$1" | grep -oE '[A-Za-z0-9_][A-Za-z0-9_./-]*/[A-Za-z0-9_./-]+\.(md|csv|json|txt|html)' | head -1; }

START="$(date +%s)"
N=0; DONE=0; VERIFIED=0
while IFS=$'\t' read -r ID KIND WHAT; do
  [ -n "$ID" ] || continue
  [ "$N" -lt "$MAX" ] || { log "stopping: $MAX item(s) is the limit for one run"; break; }
  ELAPSED=$(( $(date +%s) - START ))
  [ "$ELAPSED" -lt "$BUDGET" ] || { log "stopping: ${ELAPSED}s used of a ${BUDGET}s budget"; break; }
  N=$((N + 1))
  RUNNER_NAME="work-$TODAY-$(printf '%02d' "$N")"
  if ! TAKE="$(reg work take "$ID" --runner "$RUNNER_NAME" 2>&1)"; then
    log "skip $ID: $(printf '%s' "$TAKE" | tail -1)"
    N=$((N - 1))
    continue
  fi
  log "$ID taken ($KIND): $WHAT"
  ITEMDIR="$RUNDIR/$ID"; mkdir -p "$ITEMDIR"

  SHOW="$(reg work show "$ID" 2>/dev/null)"
  GOAL="$(field "$SHOW" GOAL)"
  DONE_WHEN="$(field "$SHOW" 'DONE WHEN')"
  {
    echo "Today is $TODAY (UTC). Mission Control is $GODSPEED and that is the folder you are working in."
    echo
    echo "## The item, from the work register"
    printf '%s\n' "$SHOW"
    if [ -n "$GOAL" ]; then
      echo; echo "## The goal it serves"
      reg goals show "$GOAL" 2>/dev/null || echo "(mc-goals is not installed here; the goal card is goals/$GOAL.md if it exists)"
      PB="$GODSPEED/goals/playbooks/$GOAL.md"
      echo; echo "## How this goal is won (the playbook)"
      if [ -f "$PB" ]; then cat "$PB"; else echo "(no playbook yet for $GOAL: how this goal is won has not been researched. If this item IS the playbook, write it; otherwise work from the goal's own words and say in your result that no playbook existed)"; fi
      DG="$(newest "$GODSPEED/goals/diagnoses" "$GOAL")"
      echo; echo "## The newest diagnosis of what limits it"
      if [ -n "$DG" ]; then cat "$DG"; else echo "(none)"; fi
    fi
    if [ -n "$EXTRA" ] && [ -f "$EXTRA" ]; then echo; cat "$EXTRA"; fi
    echo
    echo "## Where things go"
    echo "Anything you write for this item goes at the path DONE WHEN names, or under routines/work/$TODAY/$ID/ if it names none. Your final line is the RESULT line the recipe describes; the register is updated by the program that called you, never by you."
  } > "$ITEMDIR/prompt.txt"

  bash "$RUNNER" work-item --godspeed "$GODSPEED" --cwd "$GODSPEED" --prompt-file "$ITEMDIR/prompt.txt" \
    --timeout "$ITEM_TIMEOUT" --out "$ITEMDIR/answer.txt" \
    --allowed-tools "Bash Read Grep Glob Write Edit WebSearch WebFetch"
  RC=$?
  RESULT_LINE="$(grep -a '^RESULT:' "$ITEMDIR/answer.txt" 2>/dev/null | tail -1 | tr -d '\r')"

  if [ "$RC" -ne 0 ] || [ -z "$RESULT_LINE" ]; then
    WHY="the assistant ended (exit $RC) without a RESULT line; its output is in routines/work/$TODAY/$ID/answer.txt"
    reg work attempt "$ID" --runner "$RUNNER_NAME" --failed "$WHY" 2>&1 | sed 's/^/  /'
    log "$ID failed: $WHY"
    continue
  fi
  case "$RESULT_LINE" in
    "RESULT: FAILED:"*)
      WHY="$(printf '%s' "$RESULT_LINE" | sed 's/^RESULT: FAILED: *//' | cut -c1-300)"
      reg work attempt "$ID" --runner "$RUNNER_NAME" --failed "$WHY" 2>&1 | sed 's/^/  /'
      log "$ID failed: $WHY"
      continue ;;
  esac
  RESULT="$(printf '%s' "$RESULT_LINE" | sed 's/^RESULT: *//' | cut -c1-300)"
  reg work attempt "$ID" --runner "$RUNNER_NAME" --ok --result "$RESULT" 2>&1 | sed 's/^/  /'
  DONE=$((DONE + 1))

  # THE CHECK, NOT THE RUNNER, SAYS DONE. Exit 0 verifies. Exit 2 means the runner said done and
  # the check says not: it stays attempted, on the record, for the next decision to re-plan. Exit
  # 1 means there is no check, and a person or the decision run verifies it by observation.
  VOUT="$(reg work verify "$ID" 2>&1)"; VRC=$?
  printf '%s\n' "$VOUT" | sed 's/^/  /'
  if [ "$VRC" -ne 0 ]; then
    log "$ID attempted, not verified (verify exit $VRC)"
    continue
  fi
  VERIFIED=$((VERIFIED + 1))
  log "$ID verified"

  # A FINISHED PIECE BECOMES A PAGE AND, IF THIS MISSION CONTROL HAS A LEDGER, ONE CARD. The page is made by
  # whatever command the caller named; a mission control with no such command gets the file and no page. The
  # card goes through the ledger's own door and the ledger's own refusals: a card it will not
  # take is logged here and nothing else happens.
  FILE="$(path_in "$DONE_WHEN")"
  URL=""
  if [ -n "$FILE" ] && [ -f "$GODSPEED/$FILE" ] && [ -n "$PUBLISH_CMD" ]; then
    URL="$($PUBLISH_CMD "$GODSPEED/$FILE" --title "$WHAT" 2>/dev/null | grep -oE 'https://[^ ]+' | head -1)"
    if [ -n "$URL" ]; then
      reg work link "$ID" --url "$URL" 2>&1 | sed 's/^/  /'
      log "$ID published: $URL"
    else
      log "$ID not published here ($PUBLISH_CMD gave no address)"
    fi
  fi
  if [ -n "$URL" ] && command -v mc-attention >/dev/null 2>&1; then
    CARD="$(GODSPEED_ROOT="$GODSPEED" mc-attention file --kind deliverable \
      --what "$WHAT. It is written and ready to read." \
      --if-ignored "It waits unread, and the next piece is written without your verdict on this one." \
      --next "Open the link, read it, and reply with one word: keep, change or drop." \
      --link "$URL" --source "the work runner, $ID" --topic "${GOAL:-work}" --date "$TODAY" 2>&1)"
    log "card: $(printf '%s' "$CARD" | tail -1)"
  fi
done <<< "$ORDER_IDS"

reg work check 2>/dev/null | grep -E '^PROBLEM' | sed 's/^/  /' || true

# SAVE IT, if this mission control is a git repository. The register, the run records, the playbooks and any
# file an item named are added by name; nothing else in the folder is swept up.
FILES_SCRIPT='
let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
  let rows=[]; try { rows=JSON.parse(s); } catch(e) {}
  const re=/[A-Za-z0-9_][A-Za-z0-9_./-]*\/[A-Za-z0-9_./-]+\.(md|csv|json|txt|html)/;
  for (const r of rows) {
    if (!r.log || !r.log.some(l=>l.event==="VERIFIED"&&l.date===process.argv[1])) continue;
    const m=String(r["DONE WHEN"]||"").match(re); if (m) console.log(m[0]);
  }
});'
if [ -d "$GODSPEED/.git" ] && command -v git >/dev/null 2>&1; then
  for d in work goals forecasts attention research routines/work; do [ -e "$GODSPEED/$d" ] && git -C "$GODSPEED" add "$d" >/dev/null 2>&1; done
  for f in $(reg work list --all --json 2>/dev/null | "$NODE" -e "$FILES_SCRIPT" "$TODAY"); do
    [ -f "$GODSPEED/$f" ] && git -C "$GODSPEED" add "$f" >/dev/null 2>&1
  done
  if ! git -C "$GODSPEED" diff --cached --quiet 2>/dev/null; then
    git -C "$GODSPEED" commit -q -m "Work $TODAY: $DONE attempted, $VERIFIED verified" >/dev/null 2>&1 || true
    git -C "$GODSPEED" remote get-url origin >/dev/null 2>&1 && git -C "$GODSPEED" push -q origin HEAD >/dev/null 2>&1 || true
  fi
fi
[ -n "$MISSING" ] && log "not on this computer:$MISSING"
log "run end: $N taken, $DONE attempted, $VERIFIED verified"
